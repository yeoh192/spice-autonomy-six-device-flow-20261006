{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-interface-1/repair_design/output",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "action",
        "reason",
        "evidence_tests",
        "edits"
      ],
      "properties": {
        "action": {
          "enum": [
            "experiment",
            "patch"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "evidence_tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true
        },
        "adapter": {
          "enum": [
            "parameter",
            "behavioral_voltage",
            "existing_node_rewire"
          ]
        },
        "edits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "old",
              "new"
            ],
            "additionalProperties": false,
            "properties": {
              "old": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "new": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "action",
        "reason",
        "evidence_tests",
        "edits"
      ],
      "properties": {
        "action": {
          "enum": [
            "stop"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "evidence_tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true
        },
        "adapter": {
          "enum": [
            "parameter",
            "behavioral_voltage",
            "existing_node_rewire"
          ]
        },
        "edits": {
          "type": "array",
          "maxItems": 0
        }
      },
      "additionalProperties": false
    }
  ]
}
