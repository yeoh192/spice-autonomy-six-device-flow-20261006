.subckt ACS70310 IP+ IP- VCC VOUT NC/GND DUT_GND
XSensor_BW N002 N004 N002 opamp Aol=100K GBW=240k
B1 N004 DUT_GND V=if({polarity}== 2,delay(((V(IP+)-V(IP-))/1n*{Sensitivity}*{CF}*(V(Vcc)/5)+(V(Vcc)/2), 1n), delay((V(IP+)-V(IP-))/1n*{Sensitivity}*{CF}*(V(Vcc)/5)+(V(Vcc)/10), 1n)))
VSat_Low N003 DUT_GND 200mV
XOutput_stage N002 Vout N001 N003 Vout level.2 Avol=1Meg GBW=10Meg Slew=10Meg ilimit=25m rail=0 Vos=0 phimargin=45 en=0 enk=0 in=0 ink=0 Rin=500Meg
VSat_High N001 DUT_GND 4.8V
I1 DUT_GND VCC 13mA
Rp IP+ IP- 1n
.lib "opamp.sub"
.lib "UniversalOPAmps2.sub"
.backanno
.ends ACS70310
.end
