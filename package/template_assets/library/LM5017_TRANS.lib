*$
.subckt TOFF_LOGIC_U3_S7 1 2 3 4  
S_U3_S7         3 4 1 2 _U3_S7
RS_U3_S7         1 2 1G
.MODEL         _U3_S7 VSWITCH Roff=1e7 Ron=1e3 VH=2V VT=2.5V TD=0
.ends TOFF_LOGIC_U3_S7
*$
.model Dbreak D Is=1e-14 Cjo=.1pF Rs=.1
